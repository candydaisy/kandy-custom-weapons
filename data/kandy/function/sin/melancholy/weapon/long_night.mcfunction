# Run as and at a target Shattered at night by a Long Night wielder: players hit get Darkness 3s,
# and the wielder gets back one heart (Regeneration II for 3s heals exactly 2 HP)
effect give @s[type=minecraft:player] minecraft:darkness 3 0
effect give @p[tag=kandy.frost_wielder] minecraft:regeneration 3 1 true
