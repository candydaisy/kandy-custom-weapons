# function kandy:sin/lust/weapon/retier {tier:2}: raise the held blade's tier, reset its progress, rewrite its lore
$item modify entity @s weapon.mainhand [{type:"minecraft:set_custom_data",tag:'{sin:"lust",type:"weapon",tier:$(tier),deeds:0}'},{type:"minecraft:set_lore",mode:"replace_all",lore:[{text:"+2 attack damage. Charged hits grant brief Absorption.",color:"gray",italic:false},{text:"Desire builds as you sprint: +1 reach at 500, Speed I at 1000.",color:"gray",italic:false},{text:"Right-click: Embrace. Lunge at who you look at for 500 Desire (12s cooldown).",color:"gold",italic:false},{text:"At low health it grants Strength, but brings slowness and darkness.",color:"dark_red",italic:false},{text:"At 2 hearts or less it bleeds you, but charged hits heal 2 hearts.",color:"dark_red",italic:false},{text:"Taking a hit cools your Desire by 250.",color:"dark_red",italic:false},{text:"Sin of Lust · Tier $(tier)",color:"#ff4fa3",italic:false},{text:"Indulge it: Embraces, then kills while bleeding, deepen the sin.",color:"dark_gray",italic:false}]},{type:"minecraft:set_components",components:{"minecraft:consumable":{consume_seconds:3600.0f,animation:"none",sound:"minecraft:intentionally_empty",has_consume_particles:false,on_consume_effects:[]}}}]
$title @s actionbar {text:"Your Lust deepens: Tier $(tier)",color:"#ff4fa3",bold:true}
playsound minecraft:entity.player.breath player @a[distance=..16] ~ ~ ~ 1 0.6
playsound minecraft:block.anvil.use player @s ~ ~ ~ 0.6 0.6
particle minecraft:heart ~ ~1.5 ~ 0.5 0.5 0.5 0 12
