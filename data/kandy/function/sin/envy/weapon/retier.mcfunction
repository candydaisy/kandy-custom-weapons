# function kandy:sin/envy/weapon/retier {tier:2}: raise the held bow's tier, reset its progress, rewrite its lore
# Pre-revamp bows pick up the new sin keys here too (their old ability key is left alongside, harmlessly)
$item modify entity @s weapon.mainhand [{type:"minecraft:set_custom_data",tag:'{sin:"envy",type:"weapon",tier:$(tier),deeds:0}'},{type:"minecraft:set_lore",mode:"replace_all",lore:[{text:"Aim at a creature while drawing for 0.75s to Lock On (it glows).",color:"gray",italic:false},{text:"Full-draw arrows curve toward your locked target, for 15% less damage.",color:"gray",italic:false},{text:"Covet: hitting the player you're locked on steals all their buffs for 7s.",color:"gray",italic:false},{text:"Sneak + full draw: Falcon Volley, 3 extra homing arrows (14s cooldown).",color:"gold",italic:false},{text:"Tunnel Vision: while locked on you have Darkness and Slowness II.",color:"red",italic:false},{text:"Locking onto a player makes you glow for 3s.",color:"red",italic:false},{text:"Sin of Envy · Tier $(tier)",color:"#4caf50",italic:false},{text:"Indulge it: hits on your lock, then kills on it, deepen the sin.",color:"dark_gray",italic:false}]}]
$title @s actionbar {text:"Your Envy deepens: Tier $(tier)",color:"#4caf50",bold:true}
playsound minecraft:entity.elder_guardian.curse player @a[distance=..16] ~ ~ ~ 0.4 1.6
playsound minecraft:block.anvil.use player @s ~ ~ ~ 0.6 0.6
particle minecraft:happy_villager ~ ~1 ~ 0.5 0.8 0.5 0 30
