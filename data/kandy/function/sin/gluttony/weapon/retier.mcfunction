# function kandy:sin/gluttony/weapon/retier {tier:2}: raise the held dagger's tier, reset its progress, rewrite its lore
$item modify entity @s weapon.mainhand [{type:"minecraft:set_custom_data",tag:'{sin:"gluttony",type:"weapon",tier:$(tier),deeds:0}'},{type:"minecraft:set_lore",mode:"replace_all",lore:[{text:"Fast dagger: 6 damage, 2.0 attack speed.",color:"gray",italic:false},{text:"Charged hits leave an echo (max 4) that strikes for 3 a second later.",color:"gray",italic:false},{text:"When an echoed creature dies, its echoes jump to the nearest other one.",color:"light_purple",italic:false},{text:"Right-click: Devour. Every echo you left within 6 blocks goes off at once, +1 hunger each (15s cooldown).",color:"gold",italic:false},{text:"Insatiable: every echo that lands feeds on your hunger.",color:"red",italic:false},{text:"Sin of Gluttony · Tier $(tier)",color:"#ff8c1a",italic:false},{text:"Indulge it: Devours, then kills by echoes, deepen the sin.",color:"dark_gray",italic:false}]},{type:"minecraft:set_components",components:{"minecraft:consumable":{consume_seconds:3600.0f,animation:"none",sound:"minecraft:intentionally_empty",has_consume_particles:false,on_consume_effects:[]}}}]
$title @s actionbar {text:"Your Gluttony deepens: Tier $(tier)",color:"#ff8c1a",bold:true}
playsound minecraft:entity.player.burp player @a[distance=..16] ~ ~ ~ 1 0.6
playsound minecraft:block.anvil.use player @s ~ ~ ~ 0.6 0.6
particle minecraft:soul ~ ~1 ~ 0.5 0.8 0.5 0.02 30
