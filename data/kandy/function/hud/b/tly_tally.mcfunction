$bossbar add kandy:hud_$(id)_tly_tally ""
$scoreboard players operation #n hud_v = @s tly_$(k)
scoreboard players operation #p hud_v = #n hud_v
scoreboard players operation #p hud_v += #n hud_v
$bossbar set kandy:hud_$(id)_tly_tally color red
$bossbar set kandy:hud_$(id)_tly_tally max 15
$execute store result bossbar kandy:hud_$(id)_tly_tally value run scoreboard players get #n hud_v
$execute if score @s tly_kind matches 1 run bossbar set kandy:hud_$(id)_tly_tally name [{"text": "Slayer's Tally", "color": "#a4161a"}, {"text": " - Zombies: ", "color": "white"}, {"score": {"name": "#n", "objective": "hud_v"}, "color": "white"}, {"text": " notches (+", "color": "white"}, {"score": {"name": "#p", "objective": "hud_v"}, "color": "white"}, {"text": "%)", "color": "white"}]
